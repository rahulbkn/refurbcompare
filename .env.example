# ------------------------------------------------------------------
# RefurbCompare environment template
# Copy to .env and adjust.
# ------------------------------------------------------------------

# Runtime mode. demo|mock = sandbox (auto-seeds demo catalog on empty DB),
# live = production gating (providers need authorization records).
NODE_ENV="development"
DEMO_MODE="true"
DATA_MODE="demo"

# API bind address.
PORT="4000"
HOST="0.0.0.0"

# Primary database URL + driver.
#   sqlite:  DATABASE_URL="file:./data/dev.db"  (built-in node:sqlite; Termux-safe)
#   prisma:  DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/refurbcompare?schema=public"
DATABASE_DRIVER="sqlite"
DATABASE_URL="file:./data/dev.db"

# Queue driver. memory = single-process dev fallback; bullmq = Redis (production).
QUEUE_DRIVER="memory"
REDIS_URL="redis://127.0.0.1:6379"

# Admin API key (X-Admin-Key header on /api/v1/admin/*). Change in production.
# ADMIN_SECRET is an accepted alias (ADMIN_API_KEY takes precedence).
ADMIN_API_KEY="dev-admin-key"
ADMIN_SECRET=""

# Comma-separated allowed CORS origins (empty = allow all in dev).
CORS_ORIGINS=""

# Per-IP rate limit (requests per minute).
RATE_LIMIT_MAX="60"
LOG_LEVEL="info"

# Ingest routine knobs.
SYNC_ENABLED=true
SYNC_MOCK_PROVIDER=false
API_CRON_SYNC=false

# Public base URL used by the frontend redirects/canonical links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Demo mode for the Next.js frontend. Keep true until an authorized feed is wired in.
NEXT_PUBLIC_DEMO_MODE="true"

# Backend API origin. When set, the frontend's Repository adapter routes
# page/server data through the Fastify API (lib/api-client.ts) instead of direct
# DB access. Required for: API-driven products/search/comparison, the /go proxy,
# and price alerts.
NEXT_PUBLIC_API_URL="http://127.0.0.1:4000"
API_BASE_URL="http://127.0.0.1:4000"

# Cloudflare account/database identifiers (secrets; never commit real values).
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_DATABASE_ID=""

# Provide secrets ("wrangler secret put") or an authorized .env used by CI:
#   EXTERNAL_API_URL  — Mode A backend origin (server-only, never bootstrapped
#                       into the client bundle)
#   API_INTERNAL_TOKEN — token sent as X-Admin-Key when the frontend/cron calls
#                       the backend admin endpoints (set equal to ADMIN_API_KEY).
#                       Not required for public endpoints.
#
# Cloudflare:
#   NEXT_PUBLIC_APP_URL  — public site origin (wrangler [vars])
#   NEXT_PUBLIC_DEMO_MODE — "true" until an authorized feed is wired in
#   FRONTEND_ORIGIN      — server-only origin used to build absolute URLs for the
#                          same-origin proxy; defaults to NEXT_PUBLIC_APP_URL
#   API_MODE             — "external" (default, Mode A) or "hyperdrive" (Mode B)
#   EXTERNAL_API_TIMEOUT_MS — gateway timeout (default 10000)
#   SYNC_PROVIDERS       — comma-separated provider slugs for the cron worker
#   SYNC_MODE            — "MOCK" (demo) | "API" | "FEED" | "AUTHORIZED_CRAWL" |
#                          "MANUAL_IMPORT" (connector source for the cron sync)
#
# AdSense (optional; ad slots are disabled until both are set):
#   NEXT_PUBLIC_ADSENSE_ENABLED="true"
#   NEXT_PUBLIC_ADSENSE_CLIENT="ca-pub-XXXXXXXXXXXXXXXX"

# Provider secrets (backend ingestion; only read when the matching connector is
# ENABLED and a complete authorization record exists). Store real keys in a
# secret manager, never in git.
REFURBCOMPARE_CASHIFY_KEY=""
REFURBCOMPARE_BUDLI_KEY=""
REFURBCOMPARE_SOCIALCOMMERCE_KEY=""

# Provider enablement is stored in the ProviderSetting table (admin authorize
# endpoint), NOT in env. The keys below are reserved for CI/secret-manager
# docs only; they are not read by the API:
#   CASHIFY_ENABLED / CASHIFY_MODE / CASHIFY_AUTHORIZATION_STATUS
#   BUDLI_ENABLED / BUDLI_MODE / BUDLI_AUTHORIZATION_STATUS
#   REFIT_ENABLED / REFIT_MODE / REFIT_AUTHORIZATION_STATUS
#   SAHIVALUE_ENABLED / SAHIVALUE_MODE / SAHIVALUE_AUTHORIZATION_STATUS
#   MOBILEGOO_ENABLED / MOBILEGOO_MODE / MOBILEGOO_AUTHORIZATION_STATUS
