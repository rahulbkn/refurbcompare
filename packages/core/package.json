{
  "name": "@refurbcompare/core",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-independent business logic: types, normalization, matching, scoring, redirect safety, repository/queue contracts, services.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
