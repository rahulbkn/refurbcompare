{
  "name": "@refurbcompare/db",
  "version": "0.1.0",
  "private": true,
  "description": "Database access layer: Prisma schema (production Postgres), client export, seed, and the repository adapters (prisma + sqlite dev fallback).",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json && node scripts/copy-generated.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "prisma generate",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:migrate:init": "prisma migrate dev --name init --schema prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate:status": "prisma migrate status --schema prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.5.0",
    "@refurbcompare/core": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prisma": "^6.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
