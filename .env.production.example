# ------------------------------------------------------------------
# RefurbCompare production env template (Cloudflare Workers, Mode A)
# Copy to .env or inject via `wrangler secret put` / CI secrets.
# ------------------------------------------------------------------

# --- Public site (safe to share with the client) ---
NEXT_PUBLIC_APP_URL="https://refurbcompare.example.com"
NEXT_PUBLIC_DEMO_MODE="true"   # flip to "false" only once an authorized feed is live
FRONTEND_ORIGIN="https://refurbcompare.example.com"

# --- Mode A backend (server-only secrets) ---
# Set with: wrangler secret put EXTERNAL_API_URL
#           wrangler secret put API_INTERNAL_TOKEN
EXTERNAL_API_URL=""
API_INTERNAL_TOKEN=""
API_MODE="external"            # external = Mode A (default) | hyperdrive = Mode B
EXTERNAL_API_TIMEOUT_MS="10000"

# Backend-only (fastify API) settings.
NODE_ENV="production"
DEMO_MODE="false"
DATA_MODE="live"
API_BASE_URL=""

# --- Cron worker ---
# Only providers with enabled=true + authorizationStatus=APPROVED are synced.
# Never put an unauthorized provider here.
SYNC_PROVIDERS="cashify,budli,refit,sahivalue,mobilegoo"
SYNC_MODE="MOCK"   # MOCK(demo) | API | FEED | AUTHORIZED_CRAWL | MANUAL_IMPORT

# Cloudflare identifiers (secrets; never commit real values).
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_DATABASE_ID=""

# --- AdSense (optional, disabled until both are set) ---
NEXT_PUBLIC_ADSENSE_ENABLED="false"
NEXT_PUBLIC_ADSENSE_CLIENT=""

# --- Backend (shipped separately / Mode B) ---
DATABASE_DRIVER="prisma"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/refurbcompare?schema=public"
ADMIN_API_KEY="change-me-in-production"